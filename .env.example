# Public address of the site. Include http:// or https://
#   On your own PC for testing:   http://localhost
#   On a real server:             https://flauna.yourdomain.com
SITE_URL=http://localhost

DJANGO_SECRET_KEY=put-a-long-random-string-here
DJANGO_DEBUG=0
DB_HOST=db
DB_PASSWORD=put-another-random-string-here

# Google login (see README step 4). Leave empty to use only email+password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=gemma3:4b
MODERATE_FORUM=1

# Web Push (generate with: docker compose run --rm --no-deps web python manage.py generate_vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:you@example.com
